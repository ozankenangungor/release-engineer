# Server only. Copy to .env.local and supply your own key.
ANTHROPIC_API_KEY=

# Optional: defaults to the model configured in src/lib/config.ts.
# Use a Claude model that supports structured JSON outputs.
ANTHROPIC_MODEL=claude-sonnet-5-5

# Optional: increases GitHub API rate limits for public PRs.
# Private repositories remain unsupported even if this token can access them.
GITHUB_TOKEN=

# Provisioned by Clerk and Neon through Vercel Marketplace.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# Configure privately. Sandbox remains the default; never paste server keys into chat.
PADDLE_ENVIRONMENT=sandbox
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
# Only required for an explicitly enabled live billing environment.
PADDLE_PRICE_ID=
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
