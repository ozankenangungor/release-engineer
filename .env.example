# Server only. Copy to .env.local and supply your own key.
ANTHROPIC_API_KEY=

# Optional: defaults to the model configured in src/lib/config.ts.
# Use a Claude model that supports structured JSON outputs.
ANTHROPIC_MODEL=claude-sonnet-5-5

# Optional: increases GitHub API rate limits for public PRs.
# Private repositories remain unsupported even if this token can access them.
GITHUB_TOKEN=
